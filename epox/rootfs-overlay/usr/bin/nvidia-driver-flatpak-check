#!/bin/bash

set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nvidia-flatpak-check"
STATE_FILE="$STATE_DIR/last-driver-version"
LOG_FILE="$STATE_DIR/check.log"

mkdir -p "$STATE_DIR"

# Give the NVIDIA driver a moment to become available after login.
for _ in {1..30}; do
    CURRENT_VERSION="$(/usr/bin/nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -n1)"

    if [[ -n "$CURRENT_VERSION" ]]; then
        break
    fi

    sleep 2
done

# If nvidia-smi still isn't available, don't change the stored version.
if [[ -z "${CURRENT_VERSION:-}" ]]; then
    printf '%s NVIDIA driver not available\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" >> "$LOG_FILE"
    exit 0
fi

LAST_VERSION=""
if [[ -f "$STATE_FILE" ]]; then
    LAST_VERSION="$(cat "$STATE_FILE")"
fi

printf '%s Current NVIDIA driver: %s, last reported: %s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" \
    "$CURRENT_VERSION" \
    "${LAST_VERSION:-<none>}" >> "$LOG_FILE"

# First run: simply record the driver version.
if [[ -z "$LAST_VERSION" ]]; then
    printf '%s\n' "$CURRENT_VERSION" > "$STATE_FILE"
    exit 0
fi

# Driver changed: update Flatpaks.
if [[ "$CURRENT_VERSION" != "$LAST_VERSION" ]]; then
    printf '%s NVIDIA driver changed (%s -> %s), running Flatpak update\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" \
        "$LAST_VERSION" \
        "$CURRENT_VERSION" >> "$LOG_FILE"

    if /usr/bin/flatpak update -y >> "$LOG_FILE" 2>&1; then
        printf '%s\n' "$CURRENT_VERSION" > "$STATE_FILE"
        printf '%s Flatpak update completed\n' \
            "$(date '+%Y-%m-%d %H:%M:%S')" >> "$LOG_FILE"
    else
        printf '%s Flatpak update FAILED; keeping previous driver version\n' \
            "$(date '+%Y-%m-%d %H:%M:%S')" >> "$LOG_FILE"
        exit 1
    fi
else
    printf '%s NVIDIA driver unchanged; no Flatpak update needed\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" >> "$LOG_FILE"
fi
